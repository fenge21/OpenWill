# OpenWill Configuration
# Copy this file to .env and fill in your settings

# ===== LLM Configuration =====
# Provider: openai / anthropic / ollama
LLM_PROVIDER=openai

# Model name
LLM_MODEL=gpt-4o

# API key (required for OpenAI/Anthropic)
LLM_API_KEY=sk-your-api-key-here

# API base URL (optional, for OpenAI-compatible services)
# OpenAI: https://api.openai.com/v1
# DeepSeek: https://api.deepseek.com/v1
# Moonshot: https://api.moonshot.cn/v1
# ZhipuAI: https://open.bigmodel.cn/api/paas/v4
# Ollama: http://localhost:11434/v1
LLM_BASE_URL=

# Fallback model (optional, auto-switches when primary model fails)
# FALLBACK_MODEL=deepseek-chat
# FALLBACK_API_KEY=sk-your-fallback-key
# FALLBACK_BASE_URL=https://api.deepseek.com/v1

# ===== Agent Configuration =====
# Cycle interval (seconds)
CYCLE_DELAY=5

# Data storage directory
DATA_DIR=data

# ===== Web Search Configuration =====
# Search provider: tavily / duckduckgo / auto (default: auto)
# auto: try Tavily first (if API key available), fallback to DuckDuckGo
SEARCH_PROVIDER=auto
# Tavily API key (get one at https://tavily.com)
TAVILY_API_KEY=

# ===== Network Configuration =====
# HTTP/HTTPS proxy (needed only in regions with restricted internet access)
# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
